# HUFS Career Atlas (AI 과선배) — 환경변수 예시. 실제 비밀키를 커밋하지 마세요.
# 사용: cp .env.example web/.env.local 후 값 수정

# ---- LLM 응답 생성 ----
# demo (기본, LLM 미사용 템플릿) | local (로컬 vLLM) | openai_compatible (클라우드 API)
LLM_PROVIDER=demo
LLM_TIMEOUT_MS=90000

# local: scripts/start_llm.sh 로 띄운 vLLM OpenAI 호환 서버
LOCAL_LLM_BASE_URL=http://127.0.0.1:8009/v1
LOCAL_LLM_SERVED_NAME=local-llm
LOCAL_LLM_MODEL=Qwen/Qwen3-14B

# openai_compatible: 공식 문서로 확인한 OpenAI 호환 엔드포인트만 지정 (예: 네이버클라우드 CLOVA Studio
# 의 HyperCLOVA X 호환 API — 엔드포인트·모델명은 반드시 공식 문서에서 확인 후 입력)
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=

# ---- GPU ML 사이드카 (임베딩·리랭커) ----
# 비우면 로컬 n-gram·개념 확장 검색만 사용 (API·GPU 불필요)
ML_SERVICE_URL=http://127.0.0.1:8008
ENABLE_RERANK=true

# ---- 관리자 ----
# 설정 시 데이터 Import 저장에 x-admin-token 헤더 필요. 운영 환경에서는 반드시 설정.
ADMIN_TOKEN=

# ---- AI 과선배 2.0 신규 기능 (Feature Flag · 기본 꺼짐) ----
# 1 일 때만 /campus (HUFS 선배마을 Campus Lounge) 노출
FEATURE_CAMPUS_LOUNGE=
# 1 일 때만 /market (Career Market · My Skill Gap) 노출
FEATURE_CAREER_INTEL=

# ---- Career Intelligence 외부 API (키가 없으면 '테스트 Fixture'로 명시 표시) ----
# 공공데이터포털 '한국산업인력공단_NCS 기준정보 조회' serviceKey
NCS_SERVICE_KEY=
# 사람인 채용정보 API — 이용신청·승인 후 발급된 access-key (1일 500회)
SARAMIN_ACCESS_KEY=
# 0 이면 외부 API 호출 전면 차단 (PUBLIC_DEMO=1 에서는 항상 차단)
CAREER_EXTERNAL_API=

# ---- 세션 ----
# 32자 이상 임의 문자열. 없으면 서버 재시작 시 세션이 무효가 됩니다.
SESSION_SECRET=

# ---- 기능 플래그 (모두 기본 꺼짐, 1 일 때만 켜짐) ----
FEATURE_CAMPUS_LOUNGE=
FEATURE_CAREER_INTEL=
FEATURE_ALUMNI_NETWORK=
# 1 이면 외부 공개 잠금 모드 (관리자·쓰기 차단, 가상 데이터만 사용)
PUBLIC_DEMO=

# ---- AI 시연 게이트 ----
# 1 이면 관리자가 시작한 시연 시간에만 LLM 을 사용합니다.
AI_DEMO_GATE=
AI_DEMO_MAX_CONCURRENCY=2
AI_DEMO_MAX_PER_USER_10M=20
AI_DEMO_MAX_REQUESTS=400

# ---- 외부 직무·채용 API (미설정이면 테스트 Fixture 사용) ----
NCS_SERVICE_KEY=
SARAMIN_ACCESS_KEY=
