# 복사해서 사용: cp env.sh.example env.sh && source env.sh
# 프로젝트 내부에 Node·캐시를 둘 때의 예시입니다. 시스템 Node 22 를 쓰면 필요 없습니다.
VC_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export PATH="$VC_ROOT/.tools/node/bin:$PATH"
export HF_HOME="$VC_ROOT/ml/.hf_cache"
export PLAYWRIGHT_BROWSERS_PATH="$VC_ROOT/.tools/ms-playwright"
export NEXT_TELEMETRY_DISABLED=1
